# Copy to `.env`. These are the Node backend's settings.
# Where the Python AI service is reachable. Locally it's localhost;
# in Docker (M3) this becomes the service name, e.g. http://ai:8000.
PYTHON_SERVICE_URL=http://localhost:8000

# Port this Node backend listens on.
PORT=3000

# Postgres connection. Locally via Docker compose this is the `db` service.
DATABASE_URL=postgres://openly:openly@localhost:5432/openly

# Secret used to sign JWTs. MUST be set to a long random value in production.
JWT_SECRET=dev-insecure-secret-change-me

# How often (ms) the background worker polls for pending jobs.
WORKER_POLL_MS=2000
