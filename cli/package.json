{
  "name": "openly-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Openly CLI: capture a session window and enqueue a draft job.",
  "type": "module",
  "bin": { "openly": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "typescript-eslint": "^8.10.0"
  }
}
